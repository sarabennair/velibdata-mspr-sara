# ============================================================
# VélibData Terraform Variables — EXAMPLE FILE
# Copy this file:  cp terraform.tfvars.example terraform.tfvars
# Fill in your values. NEVER commit terraform.tfvars to git.
# ============================================================

resource_group_name     = "rg-velibdata"
location                = "germanywestcentral"   # allowed: polandcentral, switzerlandnorth, swedencentral, norwayeast, germanywestcentral
storage_account_name    = "velibdata1c53"         # globally unique — lowercase, no hyphens
key_vault_name          = "kv-velib-1c53"         # globally unique
eventhub_namespace_name = "evhns-velib-1c53"      # globally unique
adf_name                = "adf-velib-1c53"        # globally unique

# --- Event Hubs Capture (Standard namespace, low-cost settings) ---
eventhub_capture_container_name      = "bronze"
eventhub_capture_interval_in_seconds = 900
eventhub_capture_size_limit_in_bytes = 10485760

# --- Azure SQL Database (economical SKU for Azure for Students demos) ---
sql_server_name                   = "sql-velib-1c53"    # globally unique, lowercase, hyphens allowed
sql_database_name                 = "sqldb-velibdata"
sql_admin_login                   = "velibadmin"
sql_sku_name                      = "Basic"
sql_max_size_gb                   = 2
sql_public_network_access_enabled = true
sql_allow_azure_services          = true

alert_email       = "your-email@epsi.fr"
budget_amount     = 100
budget_start_date = "2026-05-01T00:00:00Z"
